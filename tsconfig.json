{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./build",

    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "lib": ["ES2020"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "sourceMap": true,
    "declaration": false,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "build"]
}
